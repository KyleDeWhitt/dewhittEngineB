# Server
PORT=3000
CLIENT_URL=https://dewhittdesigns.com

# JWT
JWT_SECRET=replace-with-a-long-random-string

# Database (MySQL - Hostinger remote MySQL)
DB_HOST=replace-with-hostinger-mysql-server-host
DB_USER=replace-with-db-username
DB_PASSWORD=replace-with-db-password
DB_NAME=replace-with-db-name

# Email (Resend - sends over HTTPS so it works on Render's free tier)
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM=Dewhitt Fit <no-reply@dewhittdesigns.com>

# Stripe
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret